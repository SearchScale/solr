<config>
  <luceneMatchVersion>${tests.luceneMatchVersion:LATEST}</luceneMatchVersion>
  <dataDir>${solr.data.dir:}</dataDir>
  <directoryFactory name="DirectoryFactory" class="${solr.directoryFactory:solr.MockDirectoryFactory}"/>
  <schemaFactory class="ClassicIndexSchemaFactory"/>
  <!-- Luxir indexes LuxirTextField fields; other formats per field from the schema -->
  <codecFactory class="org.apache.solr.luxir.codec.LuxirCodecFactory"/>

  <updateHandler class="solr.DirectUpdateHandler2">
    <updateLog enable="${luxir.test.ulog:true}"><str name="dir">${solr.ulog.dir:}</str></updateLog>
  </updateHandler>

  <query>
    <!-- no result caching: every request must run a search -->
    <queryResultCache size="0"/>
  </query>

  <!-- /select: Solr's default components, with Luxir's query and facet components. -->
  <searchComponent name="luxirQuery" class="org.apache.solr.luxir.codec.LuxirCodecQueryComponent"/>
  <searchComponent name="luxirFacet" class="org.apache.solr.luxir.codec.LuxirFacetComponent"/>
  <searchComponent name="luxirFacetModule" class="org.apache.solr.luxir.codec.LuxirFacetModule"/>
  <requestHandler name="/select" class="solr.SearchHandler">
    <arr name="components">
      <str>luxirQuery</str>
      <str>luxirFacet</str>
      <str>luxirFacetModule</str>
      <str>mlt</str>
      <str>highlight</str>
      <str>stats</str>
      <str>expand</str>
      <str>terms</str>
      <str>debug</str>
    </arr>
  </requestHandler>

  <!-- Stock Solr over the same index (it reads the Luxir postings through the codec). -->
  <requestHandler name="/lucene" class="solr.SearchHandler"/>

  <!-- joins between Luxir string columns run natively; the reference fields fall back to Solr's join -->
  <queryParser name="join" class="org.apache.solr.luxir.codec.LuxirJoinQParserPlugin"/>

  <requestHandler name="/update" class="org.apache.solr.luxir.codec.LuxirUpdateRequestHandler"/>
  <requestHandler name="/update-standard" class="solr.UpdateRequestHandler"/>
  <requestHandler name="/get" class="solr.RealTimeGetHandler"/>
</config>
