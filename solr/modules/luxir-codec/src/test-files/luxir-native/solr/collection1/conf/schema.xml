<schema name="luxir-native" version="1.7">
  <uniqueKey>id</uniqueKey>
  <fieldType name="string" class="solr.StrField" sortMissingLast="true" docValues="true"/>
  <fieldType name="plong" class="solr.LongPointField" docValues="true"/>
  <fieldType name="pint" class="solr.IntPointField" docValues="true"/>

  <!-- Luxir analyzes and inverts these fields itself -->
  <fieldType name="text_lx" class="org.apache.solr.luxir.codec.LuxirTextField"/>
  <!-- the same analysis chain, indexed by Lucene: the reference -->
  <fieldType name="text_ref" class="solr.TextField">
    <analyzer class="org.luxir.lucene.analysis.LuxirAnalyzer"/>
  </fieldType>

  <field name="id" type="string" indexed="true" stored="true" required="true"/>
  <field name="_version_" type="plong" indexed="false" stored="false"/>
  <field name="title_lx" type="text_lx" indexed="true" stored="true"/>
  <field name="body_lx" type="text_lx" indexed="true" stored="true" multiValued="true"/>
  <field name="title_ref" type="text_ref" indexed="true" stored="false"/>
  <field name="body_ref" type="text_ref" indexed="true" stored="false" multiValued="true"/>
  <field name="cat" type="string" indexed="true" stored="true"/>
  <field name="year" type="pint" indexed="true" stored="true"/>
  <!-- a catch-all copy target whose name Luxir's schema cannot hold (it starts with '_') -->
  <field name="_text_lx" type="text_lx" indexed="true" stored="false" multiValued="true"/>
  <field name="_text_ref" type="text_ref" indexed="true" stored="false" multiValued="true"/>
  <dynamicField name="*_lx" type="text_lx" indexed="true" stored="true"/>
  <dynamicField name="*_ref" type="text_ref" indexed="true" stored="false"/>

  <copyField source="title_lx" dest="title_ref"/>
  <copyField source="body_lx" dest="body_ref"/>
  <copyField source="note_lx" dest="note_ref"/>
  <copyField source="title_lx" dest="_text_lx"/>
  <copyField source="body_lx" dest="_text_lx"/>
  <copyField source="title_lx" dest="_text_ref"/>
  <copyField source="body_lx" dest="_text_ref"/>
</schema>
