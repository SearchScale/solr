<schema name="schema-embed-collection" version="1.7">
  <fieldType name="string" class="solr.StrField" multiValued="false"/>
  <fieldType name="plong" class="solr.LongPointField" useDocValuesAsStored="false"/>

  <!-- dimension must match MockEmbedServer's hash-demo embedder dimension in the test -->
  <fieldType name="knn_vector" class="solr.DenseVectorField" vectorDimension="32"
             knnAlgorithm="remote_hnsw" similarityFunction="euclidean"
             hnswM="8" hnswEfConstruction="50"
             cuvsWriterThreads="4" cuvsIntGraphDegree="32" cuvsGraphDegree="16"
             cuvsHnswLayers="1"/>

  <field name="id" type="string" indexed="true" stored="true" required="true"/>
  <!-- raw text; the remote-embedding update chain reads this and writes "vector" before the
       document ever reaches the codec -->
  <field name="content" type="string" indexed="false" stored="true"/>
  <field name="vector" type="knn_vector" indexed="true" stored="false"/>
  <field name="_version_" type="plong" indexed="true" stored="true"/>

  <uniqueKey>id</uniqueKey>
</schema>
